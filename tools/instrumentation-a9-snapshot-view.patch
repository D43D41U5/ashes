+// ═══ INSTRUMENTATION JETABLE — MESURE A9 (docs/specs/lieux-batis.md) — NE PAS COMMITTER ═══
+// Fenêtres d'UNE SECONDE : somme et pic du coût de `syncStructures` par snapshot, sous-coûts
+// doorPairs/nappe/pans, et coûts worker (`postMessage`, clone des structures) relayés par le
+// message. Lu par `tools/perf-structures.mjs` via `window.__PERF_STRUCT__`.
+const __sousCouts = { door: 0, nappe: 0, pans: 0 }
+interface __FenetrePerf {
+  t: number; n: number; syncMs: number; maxMs: number
+  doorMs: number; nappeMs: number; pansMs: number
+  postMs: number; maxPostMs: number; cloneMs: number; maxCloneMs: number; count: number
+}
+const __fenetres: __FenetrePerf[] = []
+function __releverPerfStruct(msg: SnapshotMessage, syncMs: number): void {
+  const sec = Math.floor(performance.now() / 1000)
+  let w = __fenetres[__fenetres.length - 1]
+  if (!w || w.t !== sec) {
+    w = { t: sec, n: 0, syncMs: 0, maxMs: 0, doorMs: 0, nappeMs: 0, pansMs: 0, postMs: 0, maxPostMs: 0, cloneMs: 0, maxCloneMs: 0, count: 0 }
+    __fenetres.push(w)
+  }
+  w.n += 1
+  w.syncMs += syncMs
+  if (syncMs > w.maxMs) w.maxMs = syncMs
+  w.doorMs += __sousCouts.door
+  w.nappeMs += __sousCouts.nappe
+  w.pansMs += __sousCouts.pans
+  const wp = (msg as unknown as { __perfWorker?: { postMs: number; cloneMs: number } }).__perfWorker
+  if (wp) {
+    w.postMs += wp.postMs
+    if (wp.postMs > w.maxPostMs) w.maxPostMs = wp.postMs
+    w.cloneMs += wp.cloneMs
+    if (wp.cloneMs > w.maxCloneMs) w.maxCloneMs = wp.cloneMs
+  }
+  w.count = msg.structures.length
+  ;(window as unknown as { __PERF_STRUCT__?: unknown }).__PERF_STRUCT__ = __fenetres
+}
+// ═══ FIN DE L'INSTRUMENTATION JETABLE ═══
 
